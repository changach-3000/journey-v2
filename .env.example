# Copy this file to .env.local and fill in what you have. .env.local is git-ignored.

# Convex adds this line for you when you run `npx convex dev`. Leave it empty to run on the built-in sample routes.
VITE_CONVEX_URL=

# Optional: nicer base map on route pages (maptiler.com). Without it the free CARTO "Voyager" map is used.
VITE_MAPTILER_KEY=
